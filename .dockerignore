# VCS / virtualenvs / caches — never belong in the image
.git
.github
.venv
venv
.env
.env.*
!.env.example

__pycache__
**/__pycache__
*.py[cod]
*$py.class
.pytest_cache
.mypy_cache
.ruff_cache
.pytest-tmp
.tmp-pytest-recurrence
.coverage
.coverage.*
htmlcov

# Build artifacts
build
dist
*.egg-info

# Runtime data (mounted by docker-compose as a volume instead)
data

# Not needed inside the API image
docs
android
tests
scripts
*.md
!README.md
