# Never bake local secrets or runtime state into an image.
.env
.env.*
!.env.example

# Local environments and caches
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.tmp-pytest-recurrence/

# Local data (mounted at runtime instead)
data/
*.sqlite
*.sqlite3
*.sqlite3-*
*.log

# VCS and CI metadata
.git/
.github/

# Not needed in the runtime image
android/
tests/
docs/
*.md
INSTALL-JARVIS.ps1
INSTALL_JARVIS.bat
