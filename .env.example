# Obtain a Gemini API key from Google AI Studio. Never commit the real key.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
# Development server should stay local by default.
HOST=127.0.0.1
PORT=8000
# Comma-separated exact origins for a future browser client; keep local for development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for personal-data/device APIs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_API_TOKEN=replace_with_a_random_secret_at_least_32_characters
# SQLite file is private local data; the data/ directory is git-ignored.
JARVIS_DB_PATH=data/jarvis.sqlite3
