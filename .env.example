# JARVIS Personal AI Configuration
# Copy this file to .env and fill in your values

# Gemini API Configuration
GEMINI_API_KEY=replace_me
# Primary model, plus models to fall back to if the primary is throttled.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash
# Low-latency bidirectional voice model. Must be enabled for your API project.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# Tool-loop tuning (optional; defaults shown)
# JARVIS_FIRST_TOKEN_TIMEOUT=10
# JARVIS_CHUNK_TIMEOUT=90
# JARVIS_MODEL_COOLDOWN=300

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Security - Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_API_TOKEN=replace_me_with_a_random_token_at_least_32_chars
SECRET_KEY=replace_me_with_another_random_secret_key_at_least_32_chars

# Database
JARVIS_DB_PATH=data/jarvis.sqlite3

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# Features
ENABLE_SERVER_HISTORY=false
ENABLE_MEMORY_SUGGESTIONS=false
ENABLE_TOOLS=true

# Research
RESEARCH_CACHE_TTL=300
RESEARCH_TIMEOUT=10

# Windows Agent (optional)
JARVIS_AGENT_TOKEN=replace_me_with_agent_token_at_least_32_chars
JARVIS_ALLOWED_URL_HOSTS=google.com;github.com;youtube.com;stackoverflow.com
